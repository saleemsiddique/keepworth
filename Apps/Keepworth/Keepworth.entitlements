<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The database lives in the App Group container so the widget (phase 7) can read
	     it. Changing this identifier means changing it in Project.swift and in the
	     KeepworthPersistence setup too. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.saleemsiddique.keepworth</string>
	</array>

	<!-- Sync with the user's own private iCloud (phase 9). There is no server. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.saleemsiddique.keepworth</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
