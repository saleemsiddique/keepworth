<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La base de datos vive en el contenedor del App Group para que el widget
	     (Fase 7) pueda leerla. Cambiar este identificador implica cambiarlo también
	     en Project.swift y en la configuración de KeepworthPersistence. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.saleemsiddique.keepworth</string>
	</array>

	<!-- Sync con el iCloud privado del usuario (Fase 9). No hay servidor propio. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.saleemsiddique.keepworth</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
